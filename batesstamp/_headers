  Content-Security-Policy: default-src 'none'; script-src 'self' https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js https://unpkg.com/jszip@3.10.1/dist/jszip.min.js https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.3/Sortable.min.js https://umami.ctibs.app/script.js; worker-src 'self'; child-src 'self'; connect-src 'self' https://umami.ctibs.app/api/send; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
